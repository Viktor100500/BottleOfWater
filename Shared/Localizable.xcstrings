    "A gentle nudge every 90 minutes during the day. Fine-tune it later in Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein sanfter Hinweis alle 90 Minuten tagsüber. Später in den Einstellungen anpassbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un aviso suave cada 90 minutos durante el día. Ajústalo luego en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un petit rappel toutes les 90 minutes en journée. À ajuster plus tard dans les Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un promemoria leggero ogni 90 minuti durante il giorno. Puoi regolarlo dopo nelle Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日中90分ごとにそっとお知らせ。あとで設定から調整できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "낮 동안 90분마다 가볍게 알려 드려요. 나중에 설정에서 조절할 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um lembrete leve a cada 90 minutos durante o dia. Ajuste depois nos Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мягкое напоминание каждые 90 минут днём. Настроить можно позже."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gün içinde 90 dakikada bir nazik bir hatırlatma. Daha sonra Ayarlar’dan düzenleyebilirsin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "白天每 90 分钟轻轻提醒一次，之后可在设置中调整。"
          }
        }
      }
    },
    "A glass of water, then back to it": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Glas Wasser, dann geht’s weiter"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un vaso de agua y a seguir"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un verre d’eau, et on continue"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un bicchiere d’acqua e si riparte"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "水を一杯飲んで、また続けましょう"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "물 한 잔 마시고 다시 시작해요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um copo de água e de volta ao trabalho"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стакан воды — и снова за дело"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir bardak su, sonra devam"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "喝杯水，再继续"
          }
        }
      }
    },
    "A reminder is skipped if you logged a drink in the 30 minutes before it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Erinnerung entfällt, wenn du in den 30 Minuten davor etwas getrunken hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se omite un aviso si registraste una bebida en los 30 minutos anteriores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rappel est ignoré si vous avez bu dans les 30 minutes précédentes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un promemoria viene saltato se hai registrato una bevuta nei 30 minuti precedenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直前30分以内に記録があれば、そのリマインダーはスキップされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림 30분 전 이내에 기록했다면 그 알림은 건너뛰어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O lembrete é pulado se você registrou uma bebida nos 30 minutos anteriores."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напоминание пропускается, если вы пили в течение 30 минут до него."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hatırlatmadan önceki 30 dakika içinde içtiysen o hatırlatma atlanır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果提醒前 30 分钟内已记录饮水，该提醒将被跳过。"
          }
        }
      }
    },
    "About 30 mL per kg of body weight is a common starting point. Drink more in hot weather or when you exercise.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwa 30 ml pro kg Körpergewicht sind ein üblicher Richtwert. Bei Hitze oder Sport mehr trinken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Unos 30 ml por kg de peso es un punto de partida habitual. Bebe más con calor o si haces ejercicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Environ 30 ml par kg de poids est un point de départ courant. Buvez davantage par forte chaleur ou en cas d’effort."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Circa 30 ml per kg di peso è un punto di partenza comune. Bevi di più quando fa caldo o fai sport."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "体重1kgあたり約30mLが一般的な目安です。暑い日や運動時は多めに。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체중 1kg당 약 30mL가 일반적인 출발점이에요. 덥거나 운동할 때는 더 마셔요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca de 30 ml por kg de peso é um ponto de partida comum. Beba mais no calor ou ao se exercitar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обычная отправная точка — около 30 мл на кг веса. В жару и при нагрузках пейте больше."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vücut ağırlığının kg’ı başına yaklaşık 30 ml yaygın bir başlangıç noktasıdır. Sıcakta ya da sporda daha fazla iç."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "常见的起点是每公斤体重约 30 毫升。天热或运动时请多喝。"
          }
        }
      }
    },
    "Access is off. Turn it on in Health → Sharing → Apps.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zugriff ist aus. Aktivieren unter Health → Teilen → Apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso está desactivado. Actívalo en Salud → Compartir → Apps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès est désactivé. Activez-le dans Santé → Partage → Apps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accesso è disattivato. Attivalo in Salute → Condivisione → App."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセスがオフです。ヘルスケア → 共有 → App でオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "접근이 꺼져 있어요. 건강 → 공유 → 앱에서 켜 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso está desativado. Ative em Saúde → Compartilhamento → Apps."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ выключен. Включите: Здоровье → Доступ → Приложения."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişim kapalı. Sağlık → Paylaşım → Uygulamalar’dan aç."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
