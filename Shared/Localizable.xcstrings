          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "До цели на сегодня осталось %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugünkü hedefe %@ kaldı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "距离今天的目标还差 %@。"
