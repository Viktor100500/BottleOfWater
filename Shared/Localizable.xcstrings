    "%@ left to reach today's goal.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch %@ bis zum heutigen Ziel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te faltan %@ para la meta de hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus que %@ pour l’objectif du jour."
          }
        },
