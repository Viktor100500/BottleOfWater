    "Log from the app, widgets, Control Center, Siri or right from a reminder.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eintragen in der App, per Widget, Kontrollzentrum, Siri oder direkt aus der Erinnerung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra desde la app, los widgets, el Centro de control, Siri o directamente desde un aviso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez depuis l’app, les widgets, le Centre de contrôle, Siri ou directement depuis un rappel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra dall’app, dai widget, dal Centro di Controllo, con Siri o direttamente da un promemoria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ、ウィジェット、コントロールセンター、Siri、通知から記録できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱, 위젯, 제어 센터, Siri, 알림에서 바로 기록하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registre pelo app, widgets, Central de Controle, Siri ou direto de um lembrete."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отмечайте в приложении, виджетах, Пункте управления, через Siri или прямо из напоминания."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamadan, widget’lardan, Denetim Merkezi’nden, Siri’den ya da doğrudan hatırlatmadan kaydet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
