    "Adds water to today's total and to Apple Health.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt Wasser zur heutigen Menge und zu Apple Health hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade agua al total de hoy y a Apple Salud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute de l’eau au total du jour et à Apple Santé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunge acqua al totale di oggi e a Apple Salute."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の合計とAppleヘルスケアに水を追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 합계와 Apple 건강에 물을 추가해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona água ao total de hoje e ao Apple Saúde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляет воду к сегодняшнему итогу и в Apple Health."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugünkü toplama ve Apple Sağlık’a su ekler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将饮水添加到今日总量和 Apple“健康”。"
          }
        }
      }
    },
    "Adds your quick-button amount. Change it in the app's Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt die Menge deines Schnellbuttons hinzu. Änderbar in den App-Einstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade la cantidad de tu botón rápido. Cámbiala en los ajustes de la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute la quantité de votre bouton rapide. Modifiable dans les réglages de l’app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunge la quantità del pulsante rapido. Puoi cambiarla nelle impostazioni dell’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クイックボタンの量を追加します。アプリの設定で変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빠른 버튼의 양을 추가해요. 앱 설정에서 바꿀 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona a quantidade do botão rápido. Altere nos ajustes do app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляет объём быстрой кнопки. Его можно изменить в настройках приложения."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hızlı düğme miktarını ekler. Uygulama ayarlarından değiştirebilirsin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
