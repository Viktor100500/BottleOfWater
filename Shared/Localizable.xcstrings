    "Up to %lld presets. Swipe to delete, tap Edit to reorder.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis zu %lld Vorlagen. Zum Löschen wischen, zum Sortieren auf „Bearbeiten“ tippen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta %lld preajustes. Desliza para eliminar; toca Editar para reordenar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jusqu’à %lld préréglages. Balayez pour supprimer, touchez Modifier pour réorganiser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fino a %lld preimpostazioni. Scorri per eliminare, tocca Modifica per riordinare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プリセットは最大%lld個。スワイプで削除、「編集」で並べ替え。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프리셋은 최대 %lld개예요. 밀어서 삭제하고, 편집을 눌러 순서를 바꾸세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Até %lld predefinições. Deslize para apagar, toque em Editar para reordenar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "До %lld пресетов. Смахните, чтобы удалить; нажмите «Изменить», чтобы поменять порядок."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En fazla %lld hazır ayar. Silmek için kaydır, sıralamak için Düzenle’ye dokun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最多 %lld 个预设。轻扫删除，轻点“编辑”调整顺序。"
          }
        }
      }
    },
