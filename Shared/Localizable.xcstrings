    "Used by Home Screen widgets, the Control Center button and actions on reminders.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Werden von Home-Bildschirm-Widgets, der Kontrollzentrum-Taste und den Aktionen in Erinnerungen genutzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los usan los widgets de inicio, el botón del Centro de control y las acciones de los avisos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisés par les widgets de l’écran d’accueil, le bouton du Centre de contrôle et les actions des rappels."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usati dai widget della schermata Home, dal pulsante del Centro di Controllo e dalle azioni dei promemoria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホーム画面のウィジェット、コントロールセンターのボタン、通知のアクションで使われます。"
          }
        },
        "ko": {
