    "“Until” must be later than “From”.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Bis“ muss nach „Von“ liegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Hasta» debe ser posterior a «Desde»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« À » doit être après « De »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“Alle” deve essere dopo “Dalle”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「終了」は「開始」より後にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘종료’는 ‘시작’보다 늦어야 해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“Até” deve ser depois de “Das”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«До» должно быть позже, чем «С»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Bitiş”, “Başlangıç”tan sonra olmalı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“结束”必须晚于“开始”。"
          }
        }
      }
    }
  },
  "version": "1.0"
