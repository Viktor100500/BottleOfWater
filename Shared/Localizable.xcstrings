    "They stay quiet after a glass and stop once you hit your goal.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie bleiben nach einem Glas still und hören auf, sobald du dein Ziel erreichst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se callan tras un vaso y paran al alcanzar tu meta."
          }
        },
