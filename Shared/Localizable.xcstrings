    "Every drink is saved to Health. No accounts, no tracking.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Getränk landet in Health. Keine Konten, kein Tracking."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada bebida se guarda en Salud. Sin cuentas ni rastreo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque boisson est enregistrée dans Santé. Ni compte, ni pistage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni bevuta viene salvata in Salute. Niente account, niente tracciamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録はすべてヘルスケアに保存。アカウントもトラッキングもなし。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 기록은 건강 앱에 저장돼요. 계정도 추적도 없어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada bebida é salva no Saúde. Sem contas, sem rastreamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая запись сохраняется в «Здоровье». Без аккаунтов и слежки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her içiş Sağlık’a kaydedilir. Hesap yok, takip yok."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次饮水都会保存到“健康”。无需账户，不做追踪。"
          }
        }
      }
    },
    "Every drink you log is saved to Apple Health. Bottle of Water doesn't read your health data.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Getränk wird in Apple Health gespeichert. Bottle of Water liest keine Gesundheitsdaten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada bebida se guarda en Apple Salud. Bottle of Water no lee tus datos de salud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque boisson est enregistrée dans Apple Santé. Bottle of Water ne lit pas vos données de santé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni bevuta viene salvata in Apple Salute. Bottle of Water non legge i tuoi dati sanitari."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録はすべてAppleヘルスケアに保存されます。Bottle of Waterがヘルスケアデータを読み取ることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록은 모두 Apple 건강에 저장돼요. Bottle of Water는 건강 데이터를 읽지 않아요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada bebida é salva no Apple Saúde. O Bottle of Water não lê seus dados de saúde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая запись сохраняется в Apple Health. Bottle of Water не читает ваши данные о здоровье."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her içiş Apple Sağlık’a kaydedilir. Bottle of Water sağlık verilerini okumaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次饮水都会保存到 Apple“健康”。Bottle of Water 不会读取你的健康数据。"
          }
        }
      }
    },
    "Forgot to log something? Tap + to add it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwas vergessen? Tippe auf +, um es nachzutragen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Olvidaste algo? Toca + para añadirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un oubli ? Touchez + pour l’ajouter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai dimenticato qualcosa? Tocca + per aggiungerlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録し忘れたら＋で追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록을 잊었나요? +를 눌러 추가하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esqueceu de registrar algo? Toque em + para adicionar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Забыли что-то отметить? Нажмите +, чтобы добавить."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir şeyi kaydetmeyi mi unuttun? Eklemek için + simgesine dokun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "忘记记录了？轻点 + 补上。"
          }
        }
      }
    },
